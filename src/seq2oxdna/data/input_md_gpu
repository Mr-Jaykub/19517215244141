##############################
####  PROGRAM PARAMETERS  ####
##############################
backend = CUDA
backend_precision = mixed
sim_type = MD
steps = 1000000

##############################
####    SIM PARAMETERS    ####
##############################
T = 20C
verlet_skin = 0.15
dt = 0.003

##############################
####     INTERACTIONS     ####
##############################
interaction_type = DNA
salt_concentration = 1.0
max_backbone_force = 5
max_backbone_force_far = 10

##############################
####     MD SETTINGS      ####
##############################
thermostat = brownian
newtonian_steps = 103
diff_coeff = 2.5
max_density_multiplier = 10

##############################
####    INPUT / OUTPUT    ####
##############################
max_io = 2
topology = sequence.top
conf_file = mc.conf
lastconf_file = md.conf
trajectory_file = md_traj.dat
energy_file = energy.dat

external_forces = true
external_forces_file = forces.txt

print_conf_interval = 10000
print_energy_every = 10000

time_scale = linear
restart_step_counter = 1
refresh_vel = true
